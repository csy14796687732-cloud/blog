{
  "name": "blog",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,md}\"",
    "db:generate": "cd packages/backend && npx drizzle-kit generate",
    "db:migrate": "cd packages/backend && npx drizzle-kit migrate",
    "db:studio": "cd packages/backend && npx drizzle-kit studio",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
