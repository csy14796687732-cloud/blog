{
  "buildCommand": "cd ../.. && npx turbo run build --filter=@blog/frontend",
  "outputDirectory": ".",
  "installCommand": "cd ../.. && pnpm install --filter=@blog/frontend...",
  "framework": "nuxt",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://your-backend.vercel.app/api/$1" }
  ]
}
