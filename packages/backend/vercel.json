{
  "installCommand": "cd ../.. && pnpm install --filter=@blog/backend...",
  "buildCommand": "pnpm build",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
